# Virtual environment
venv/
.venv/
env/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Jupyter Notebook
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# IDE and Editor
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Environment variables & secrets
.env
.env.*

# Data policy: Do NOT commit heavy raw/processed data files
# Data can be reproduced using src/data/download.py
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/interim/*
!data/interim/.gitkeep
*.csv
*.csv.gz
*.parquet

# Model artifacts and binaries
models/*
!models/.gitkeep
!models/best_optuna_lgb.joblib
!models/best_optuna_lgb.json
*.pkl
*.joblib
!models/best_optuna_lgb.joblib
*.pt
*.pth
*.onnx

# Results & optimization runs cache (allow summary CSVs and figures, ignore huge runs)
results/runs/*
!results/.gitkeep
!results/*.csv

# Temporary and extraction files
*.tmp
*.log
docs/extracted_*.txt

# OS-specific
.DS_Store
Thumbs.db